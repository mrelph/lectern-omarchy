pkgname=lectern-omarchy
pkgver=$(<"${startdir:-$PWD}/../VERSION")
pkgrel=1
pkgdesc='Edit and present Markdown slide decks on Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'qt6-multimedia' 'qt6-imageformats' 'poppler' 'ffmpeg' 'md4c' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'wayland-protocols')

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lectern-omarchy "$pkgdir/usr/bin/lectern-omarchy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/lectern-omarchy.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/lectern-omarchy.png"
  install -Dm644 "$startdir/lectern-omarchy.desktop" "$pkgdir/usr/share/applications/lectern-omarchy.desktop"
}
